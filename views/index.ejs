<!DOCTYPE html>
<html>
  <head>
    <title>Random Advice</title>
    <link rel="stylesheet" href="styles/styles.css" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script>
      function toggleEdit(id) {
        const adviceText = document.getElementById(`advice-text-${id}`);
        const editArea = document.getElementById(`edit-area-${id}`);
        const editBtn = document.getElementById(`edit-btn-${id}`);

        adviceText.style.display = "none";
        editArea.style.display = "block";
      }

      function toggleLock(id) {
        const lockCheckbox = document.getElementById(`lock-${id}`);
        const textarea = document.querySelector(`#edit-area-${id} textarea`);
        const saveButton = document.querySelector(
          `#edit-area-${id} button[type="submit"]`
        );
        const editBtn = document.getElementById(`edit-btn-${id}`);

        if (lockCheckbox.checked) {
          textarea.disabled = true;
          saveButton.style.display = "none";
          editBtn.style.display = "none";
        } else {
          textarea.disabled = false;
          saveButton.style.display = "inline-block";
          editBtn.style.display = "inline-block";
        }
      }
    </script>
  </head>
  <body>
    <div class="container">
      <h1 class="titulli">Random Advice</h1>
      <div class="top">
        <% if (locals.data) { %>
        <form class="d-f" action="/save" method="post">
          <textarea readonly class="shprehja" name="advice" rows="4">
<%= data %></textarea
          >
          <button type="submit">SAVE</button>
        </form>

        <% } else { %>
        <p><strong>Error:</strong> <%= error || "No advice available." %></p>
        <% } %>
        <form class="d-f" action="/" method="post">
          <button type="submit">Get New Advice</button>
        </form>
      </div>
      <ul>
        <% collection.forEach(item => { %>
        <li class="d-f">
          <div id="advice-text-<%= item.id %>">
            <p><%= item.advice %></p>
            <button
              id="edit-btn-<%= item.id %>"
              onclick="toggleEdit(<%= item.id %>)"
            >
              Edit
            </button>
          </div>

          <div id="edit-area-<%= item.id %>" style="display: none">
            <form class="d-f" action="/edit/<%= item.id %>" method="post">
              <textarea class="shprehja" name="newAdvice" rows="3">
<%= item.advice %></textarea
              >
              <button type="submit">Save</button>
            </form>
          </div>

          <form class="d-f" action="/delete/<%= item.id %>" method="post">
            <button type="submit">Delete</button>
          </form>

          <label>
            <input
              type="checkbox"
              id="lock-<%= item.id %>"
              onchange="toggleLock(<%= item.id %>)"
            />
            Lock
          </label>
        </li>
        <% }); %>
      </ul>
    </div>
  </body>
</html>
